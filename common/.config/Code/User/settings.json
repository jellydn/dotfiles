{
  // Color scheme and icon
  "workbench.colorTheme": "Maple Dark",
  "workbench.iconTheme": "catppuccin-macchiato",
  // Set sidebar to the right
  "workbench.sideBar.location": "right",
  // Show relative number
  "editor.lineNumbers": "relative",
  "workbench.editor.showTabs": "multiple",
  "window.titleBarStyle": "native",
  // Activity bar
  "workbench.activityBar.location": "bottom",
  // Need to install VSCode Custom UI Style extension https://github.com/subframe7536/vscode-custom-ui-style
  "custom-ui-style.electron": {
    // "titleBarStyle": "hidden",
    "frame": false,
    "transparent": true,
    "opacity": 0.98
  },
  "custom-ui-style.stylesheet": {
    // Setup for CSS for Which-Key
    // Let the quick pick take the full window height, so that more bindings are visible.
    ".quick-input-widget > .quick-input-list > .monaco-list": "max-height: 100vh !important;",
    // Hide editor top-right buttons, except for the dirty file indicator and settings goto icon
    ".editor .title .actions-container .action-item a:not(.codicon-close-dirty):not(.codicon-preferences-open-settings)": "display: none !important;"
  },
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#ffc600",
    "tab.activeBorder": "#ffc600"
  },
  // Mapple Theme customizations
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "interface": {
        "italic": true
      },
      "selfParameter": {
        "italic": true
      },
      "keyword": {
        "italic": true
      },
      "*.static": {
        "italic": true
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "constant.language.undefined",
          "constant.language.null",
          "constant.language.nullptr",
          "meta.type keyword.operator.expression.typeof",
          "meta.type keyword.operator.expression.keyof",
          "keyword.control",
          "keyword.function",
          "keyword.operator.new",
          "keyword.operator.borrow.and.rust",
          "storage.type",
          "storage.modifier",
          "variable.language.this",
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  // Screencast
  "screencastMode.fontSize": 32,
  "screencastMode.verticalOffset": 4,
  // Terminal
  "terminal.integrated.fontFamily": "JetBrainsMono NF",
  "terminal.integrated.fontSize": 17,
  "terminal.integrated.sendKeybindingsToShell": true,
  // Inlay hints
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.fontFamily": "GeistMono Nerd Font",
  "editor.inlayHints.fontSize": 1,
  "editor.inlayHints.padding": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.variableTypes.enabled": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  // Validation
  "js/ts.validate.enabled": true,
  // make sure you're using the local typescript
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  // Diff
  "diffEditor.codeLens": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  // General editor settings
  "editor.autoIndent": "full",
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 5,
  "editor.fontFamily": "Maple Mono NF, OperatorMonoLig Nerd Font, JetBrainsMono Nerd Font Mono, Menlo, Monaco, 'Courier New', monospacere, monospace",
  "editor.codeLensFontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.fontLigatures": true,
  "editor.fontSize": 18,
  "editor.fontWeight": "400",
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": false,
  "editor.largeFileOptimizations": false,
  "editor.letterSpacing": 0.5,
  "editor.lineHeight": 25,
  "editor.renderWhitespace": "all",
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.semanticHighlighting.enabled": true,
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "errorLens.enabledDiagnosticLevels": [
    "error"
  ],
  "errorLens.excludeBySource": [
    "cSpell"
  ],
  // Toggle excluded files extension, refer for more detail https://github.com/jellydn/vscode-toggle-excluded-files
  "files.exclude": {
    "**/bin": true,
    "**/target": true,
    "**/.output": true,
    "**/git": true,
    "**/report": true,
    "**/.cargo_cache": true,
    "**/.cursor": true,
    "**/.codereview": true,
    "**/.claude": true,
    "**/.tanstack": true,
    "**/.turbo": true,
    "**/.vercel": true,
    "**/.changes": true,
    "**/.yarn": true,
    "**/.vscode": true,
    "**/.vscode-test": true,
    "**/.git": true,
    "**/.github": true,
    "**/.grit": true,
    "**/.changeset": true,
    "**/node_modules": true,
    "**/.husky": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/cdk.out": true,
    "**/coverage": true,
    "**/.next": true,
    "**/*.tsbuildinfo": true,
    "**/*.nyc_output": true,
    "**/*.tap": true,
    "**/*.econ": true,
    "**/.astro": true,
    "**/.encore": true,
    "**/encore.gen": true,
    "**/test-results": true,
    "**/playwright-report": true
  },
