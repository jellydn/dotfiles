
# How to reload:
#   Linux: ctrl+shift+,
#   macOS: cmd+shift+,
#   Refer to https://ghostty.org/docs

# Theme
# Usage: ghostty +list-themes
theme = kanagawa-wave

# Font family
# Usage: ghostty +list-fonts
font-family =  "Maple Mono NF"
font-family-bold = "Maple Mono NF Medium"
font-family-italic = "Maple Mono NF Book Italic"
font-family-bold-italic = "Maple Mono NF Medium Italic"
# 14 on small screen, 18 on large screen
font-size = 18

# Background
background-opacity = 0.98

# Window padding
window-padding-x = 5
window-padding-y = 5

unfocused-split-opacity = 0.85

# Hide title
title = " "
# The style of the macOS titlebar.
# Available values are: "native", "transparent", "tabs", and "hidden".
macos-titlebar-style = tabs
# Hide cursor while typing
mouse-hide-while-typing = true

# No need to confirm
confirm-close-surface = false

# Shell (mise bootstrap sets login_shell to /opt/homebrew/bin/fish on Mac)
shell-integration = fish

# Copy on select
copy-on-select = true

# URL Detection and Clicking
# Enable automatic URL detection
link-url = true
# Open URLs with Cmd+Click (bypasses Zellij mouse mode)
# Ghostty will detect URLs and make them clickable

# Keymap — keep in sync with docs/terminal-keys.md
# Make Alt/Option key work nicely with Zellij on macOS, refer https://github.com/ghostty-org/ghostty/discussions/3207
keybind = alt+left=unbind
keybind = alt+right=unbind
macos-option-as-alt = true
# Pass through to jcode (hardcoded macOS prompt-jump fallbacks); clear with ctrl+l instead of cmd+k
keybind = cmd+k=unbind
keybind = cmd+j=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind
# Neovim <c-_> / tiny-term. Do not bind ctrl+minus to font size.
keybind = ctrl+minus=text:\x1f
# Linux copy/paste + new window + search + reload (macOS uses Cmd defaults)
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+comma=reload_config
# Font size on Linux (Ctrl+- is Neovim). macOS keeps Cmd+= / Cmd+-
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1

# Quick term
keybind = global:cmd+grave_accent=toggle_quick_terminal

# cmdk
keybind = cmd+l=text:cmdk -s\r
keybind = ctrl+shift+l=text:cmdk -s\r
